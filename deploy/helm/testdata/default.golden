# Source: mcp-gateway/templates/job-migrate.yaml
# Pre-install / pre-upgrade hook: applies the embedded goose migrations as
# the database owner before Helm touches the Deployment. The weight orders it
# before any other hook; the delete policy (before-hook-creation) keeps the
# last Job around for `kubectl logs` and replaces it on the next run. The
# gateway refuses to start on a schema mismatch, so a failed migration
# leaves the previous pods serving. The pod labels deliberately differ from
# the Deployment's selector so the Service, PDB and NetworkPolicy never
# match the migrate pod.
apiVersion: batch/v1
kind: Job
metadata:
  name: mcp-gateway-migrate
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway-migrate
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "0.1.0"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: migrate
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-weight: "-5"
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  backoffLimit: 2
  activeDeadlineSeconds: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mcp-gateway-migrate
        app.kubernetes.io/instance: mcp-gateway
        app.kubernetes.io/component: migrate
    spec:
      restartPolicy: Never
      # No serviceAccountName: the chart's ServiceAccount does not exist yet
      # during pre-install, and the Job never talks to the API.
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "ghcr.io/huynle/mcp-gateway:0.1.0"
          imagePullPolicy: IfNotPresent
          command: ["/migrate", "up"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
          env:
            - name: GATEWAY_MIGRATE_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-database"
                  key: "migrate-url"
          resources:
            limits:
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi

---
# Source: mcp-gateway/templates/serviceaccount.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mcp-gateway
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "local"
    app.kubernetes.io/managed-by: Helm
automountServiceAccountToken: false
---
# Source: mcp-gateway/templates/service-metrics.yaml
# Private: scraped inside the cluster, never referenced by the Ingress.
apiVersion: v1
kind: Service
metadata:
  name: mcp-gateway-metrics
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "local"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: metrics
  annotations:
    prometheus.io/path: /metrics
    prometheus.io/port: "19090"
    prometheus.io/scrape: "true"
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
  ports:
    - name: metrics
      port: 19090
      targetPort: metrics
      protocol: TCP
---
# Source: mcp-gateway/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: mcp-gateway
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "local"
    app.kubernetes.io/managed-by: Helm
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
  ports:
    - name: http
      port: 80
      targetPort: http
      protocol: TCP
---
# Source: mcp-gateway/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mcp-gateway
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "local"
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 2
  revisionHistoryLimit: 5
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: mcp-gateway
      app.kubernetes.io/instance: mcp-gateway
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mcp-gateway
        app.kubernetes.io/instance: mcp-gateway
    spec:
      serviceAccountName: mcp-gateway
      automountServiceAccountToken: false
      # Must exceed GATEWAY_DRAIN_TIMEOUT so in-flight calls finish before
      # the kubelet kills the process (decision dovthftx).
      terminationGracePeriodSeconds: 35
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        # Secret volumes cannot yield a file that is 0600 and owned by the
        # gateway user; the file provider refuses group/world-readable keys.
        # Copy it into a private emptyDir with the right mode.
        - name: key-file
          image: "busybox:1.37"
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -ec
            - |
              umask 077
              cp /keys-secret/keys.json /var/run/mcp-gateway/keys/keys.json
              chmod 0600 /var/run/mcp-gateway/keys/keys.json
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 32Mi
          volumeMounts:
            - name: key-secret
              mountPath: /keys-secret
              readOnly: true
            - name: keys
              mountPath: /var/run/mcp-gateway/keys
      containers:
        - name: gateway
          image: "mcp-gateway:local"
          imagePullPolicy: Never
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
          ports:
            - name: http
              containerPort: 18080
              protocol: TCP
            - name: metrics
              containerPort: 19090
              protocol: TCP
          env:
            
            - name: GATEWAY_LISTEN_ADDR
              value: ":18080"
            - name: GATEWAY_METRICS_ADDR
              value: "0.0.0.0:19090"
            - name: GATEWAY_DRAIN_TIMEOUT
              value: "25s"
            - name: GATEWAY_LOG_LEVEL
              value: "debug"
            - name: GATEWAY_LOG_FORMAT
              value: "text"
            - name: GATEWAY_BASE_URL
              value: "http://localhost:18080"
            - name: GATEWAY_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-database"
                  key: "app-url"
            - name: GATEWAY_JOBS_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-database"
                  key: "jobs-url"
            - name: GATEWAY_SESSION_IDLE_TIMEOUT
              value: "12h"
            - name: GATEWAY_SESSION_ABSOLUTE_TIMEOUT
              value: "168h"
            - name: GATEWAY_SESSION_COOKIE_SECURE
              value: "false"
            - name: GATEWAY_TOKEN_SIGNIN_MAX_AGE
              value: "720h"
            - name: GATEWAY_MCP_MAX_BODY
              value: "1048576"
            - name: GATEWAY_RATE_USER_PER_MIN
              value: "60"
            - name: GATEWAY_RATE_APP_PER_MIN
              value: "600"
            - name: GATEWAY_POLICY_RELOAD_INTERVAL
              value: "15s"
            - name: GATEWAY_APPROVAL_TTL
              value: "15m"
            - name: GATEWAY_APPROVAL_WAIT
              value: "30s"
            - name: GATEWAY_LEDGER_IDEMPOTENCY_WINDOW
              value: "24h"
            - name: GATEWAY_LEDGER_STALE_AFTER
              value: "2m"
            - name: GATEWAY_LEDGER_MAX_RECONCILE_ATTEMPTS
              value: "6"
            - name: GATEWAY_LEDGER_MAX_RECONCILE_AGE
              value: "24h"
            - name: GATEWAY_OAUTH_ACCESS_TOKEN_TTL
              value: "1h"
            - name: GATEWAY_OAUTH_REFRESH_TOKEN_TTL
              value: "720h"
            - name: GATEWAY_OAUTH_CODE_TTL
              value: "10m"
            - name: GATEWAY_OAUTH_REGISTER_PER_MIN
              value: "10"
            - name: GATEWAY_OAUTH_MAX_UNUSED_CLIENTS
              value: "1000"
            - name: GATEWAY_OAUTH_CLIENT_IDLE
              value: "720h"
            - name: GATEWAY_OAUTH_KEY_ROTATION
              value: "720h"
            - name: GATEWAY_OAUTH_KEY_GRACE
              value: "2h"
            - name: GATEWAY_DEFAULT_ROLE
              value: "member"
            - name: GATEWAY_BOOTSTRAP_ADMINS
              value: "http://localhost:15556/dex|CiQwOGE4Njg0Yi1kYjg4LTRiNzMtOTBhOS0zY2QxNjYxZjU0NjYSBWxvY2Fs"
            - name: GATEWAY_SECRETS_ENABLED
              value: "false"
            - name: GATEWAY_ENABLE_FAKE_CONNECTOR
              value: "true"
            - name: GATEWAY_OIDC_PROVIDERS
              value: "dex"
            - name: GATEWAY_OIDC_DEX_DISPLAY_NAME
              value: "Local dex"
            - name: GATEWAY_OIDC_DEX_ISSUER
              value: "http://localhost:15556/dex"
            - name: GATEWAY_OIDC_DEX_CLIENT_ID
              value: "gateway"
            - name: GATEWAY_OIDC_DEX_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-oidc"
                  key: "dex-client-secret"
            - name: GATEWAY_OIDC_DEX_ALLOWED_DOMAINS
              value: "example.com"
            - name: GATEWAY_KEY_PROVIDER
              value: "file"
            - name: GATEWAY_KEY_FILE
              value: "/var/run/mcp-gateway/keys/keys.json"
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 30
            periodSeconds: 2
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          resources:
            limits:
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi
          volumeMounts:
            - name: keys
              mountPath: /var/run/mcp-gateway/keys
              readOnly: true
      volumes:
        - name: key-secret
          secret:
            secretName: "mcp-gateway-keys"
            defaultMode: 0400
        - name: keys
          emptyDir:
            medium: Memory
            sizeLimit: 1Mi
---
# Source: mcp-gateway/templates/job-migrate.yaml
# Pre-install / pre-upgrade hook: applies the embedded goose migrations as
# the database owner before Helm touches the Deployment. The weight orders it
# before any other hook; the delete policy (before-hook-creation) keeps the
# last Job around for `kubectl logs` and replaces it on the next run. The
# gateway refuses to start on a schema mismatch, so a failed migration
# leaves the previous pods serving. The pod labels deliberately differ from
# the Deployment's selector so the Service, PDB and NetworkPolicy never
# match the migrate pod.
apiVersion: batch/v1
kind: Job
metadata:
  name: mcp-gateway-migrate
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway-migrate
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "local"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: migrate
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-weight: "-5"
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  backoffLimit: 2
  activeDeadlineSeconds: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mcp-gateway-migrate
        app.kubernetes.io/instance: mcp-gateway
        app.kubernetes.io/component: migrate
    spec:
      restartPolicy: Never
      # No serviceAccountName: the chart's ServiceAccount does not exist yet
      # during pre-install, and the Job never talks to the API.
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "mcp-gateway:local"
          imagePullPolicy: Never
          command: ["/migrate", "up"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
          env:
            - name: GATEWAY_MIGRATE_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-database"
                  key: "migrate-url"
          resources:
            limits:
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi

# Source: mcp-gateway/templates/prometheusrule.yaml
# Alert rules for the Prometheus Operator, over the gateway's own metric
# catalogue (docs/observability.md): no user, token or account identifier
# exists as a label, so no alert can name a person. The ledger counter has
# no "currently unresolved" gauge, so the first rule fires on any write
# that became unresolved inside the window; triage is on /operations and
# in docs/runbooks/unresolved-operations.md. Values under
# metrics.prometheusRule tune windows and thresholds.
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: mcp-gateway
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "0.1.0"
    app.kubernetes.io/managed-by: Helm
spec:
  groups:
    - name: mcp-gateway
      rules:
        - alert: MCPGatewayUnresolvedOperations
          expr: "sum(increase(ledger_operations_total{state=\"unresolved\",job=\"mcp-gateway-metrics\"}[30m])) > 0"
          for: "0m"
          labels:
            severity: "warning"
            service: mcp-gateway
          annotations:
            summary: "Writes could not be verified in the last 30m"
            description: "{{ $value }} write operation(s) became unresolved: the vendor did not confirm the outcome and reconciliation gave up. The owners were notified; an operator triages them on /admin/audit and the admin_ledger_operations view."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/unresolved-operations.md"
        - alert: MCPGatewayConnectionRefreshFailures
          expr: "sum by (app) (rate(connection_refresh_failures_total{job=\"mcp-gateway-metrics\"}[15m])) * 60 > 1"
          for: "15m"
          labels:
            severity: "warning"
            service: mcp-gateway
          annotations:
            summary: "Vendor token refreshes failing for {{ $labels.app }}"
            description: "{{ $value | printf \"%.2f\" }} refresh failures per minute for app {{ $labels.app }} over 15m. A burst across many users usually means the vendor app's client secret was rotated or revoked at the vendor; isolated failures mark single connections needs_reconnect and the user reconnects on /connections."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/vendor-app-secret-rotation.md"
        - alert: MCPGatewayAuthFailureSpike
          expr: "sum(rate(auth_failures_total{job=\"mcp-gateway-metrics\"}[5m])) * 60 > 30"
          for: "10m"
          labels:
            severity: "warning"
            service: mcp-gateway
          annotations:
            summary: "Bearer authentication failures above 30 per minute"
            description: "{{ $value | printf \"%.1f\" }} rejected bearer tokens per minute on /mcp over 5m. Break it down by auth_failures_total{reason}: unknown/malformed is scanning or token guessing (the per-IP limiter answers 429), signin_stale is users past the 30-day sign-in rule, revoked/user_disabled right after an offboarding is expected."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/incident-redaction-check.md"
        - alert: MCPGatewayVendorRateLimited
          expr: "sum by (app) (rate(vendor_rate_limited_total{job=\"mcp-gateway-metrics\"}[15m])) * 60 > 1"
          for: "15m"
          labels:
            severity: "warning"
            service: mcp-gateway
          annotations:
            summary: "{{ $labels.app }} is rate limiting the gateway"
            description: "{{ $value | printf \"%.2f\" }} vendor 429 answers per minute for app {{ $labels.app }}; the app is paused for every user until the vendor's Retry-After each time. Sustained limiting means gateway.rateLimits.appPerMinute is above what the vendor app is allowed: lower it or raise the vendor quota."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/deploy-and-rollback.md"
        - alert: MCPGatewayScrapeDown
          expr: "absent(up{job=\"mcp-gateway-metrics\"} == 1)"
          for: "5m"
          labels:
            severity: "critical"
            service: mcp-gateway
          annotations:
            summary: "No gateway replica is being scraped"
            description: "Prometheus has no healthy target for Service mcp-gateway-metrics in mcp-gateway: every replica is down, or the scrape configuration / NetworkPolicy (networkPolicy.ingress.metrics.from) no longer reaches the metrics port."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/deploy-and-rollback.md"
        - alert: MCPGatewayNoReadyReplicas
          expr: "kube_deployment_status_replicas_available{namespace=\"mcp-gateway\",deployment=\"mcp-gateway\"} < 1"
          for: "5m"
          labels:
            severity: critical
            service: mcp-gateway
          annotations:
            summary: "No ready gateway replica"
            description: "Deployment mcp-gateway in mcp-gateway has no available replica: /readyz fails on every pod (database unreachable, schema version behind the binary, or key provider down)."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/deploy-and-rollback.md"
        - alert: MCPGatewayReplicasBelowMinimum
          expr: "kube_deployment_status_replicas_available{namespace=\"mcp-gateway\",deployment=\"mcp-gateway\"} < 2"
          for: "15m"
          labels:
            severity: warning
            service: mcp-gateway
          annotations:
            summary: "Fewer than two ready gateway replicas"
            description: "The gateway runs as >= 2 identical replicas (background jobs move between them on a PostgreSQL lease, decision ysorv868); fewer than two have been available for 15 minutes."
            runbook_url: "https://github.com/huynle/mcp-gateway/blob/main/docs/runbooks/deploy-and-rollback.md"
---
# Source: mcp-gateway/templates/servicemonitor.yaml
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: mcp-gateway
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "0.1.0"
    app.kubernetes.io/managed-by: Helm
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: mcp-gateway
      app.kubernetes.io/instance: mcp-gateway
      app.kubernetes.io/component: metrics
  namespaceSelector:
    matchNames:
      - mcp-gateway
  endpoints:
    - port: metrics
      path: /metrics
      interval: 30s
      scrapeTimeout: 10s
---
# Source: mcp-gateway/templates/job-migrate.yaml
# Pre-install / pre-upgrade hook: applies the embedded goose migrations as
# the database owner before Helm touches the Deployment. The weight orders it
# before any other hook; the delete policy (before-hook-creation) keeps the
# last Job around for `kubectl logs` and replaces it on the next run. The
# gateway refuses to start on a schema mismatch, so a failed migration
# leaves the previous pods serving. The pod labels deliberately differ from
# the Deployment's selector so the Service, PDB and NetworkPolicy never
# match the migrate pod.
apiVersion: batch/v1
kind: Job
metadata:
  name: mcp-gateway-migrate
  namespace: mcp-gateway
  labels:
    helm.sh/chart: mcp-gateway-0.2.0
    app.kubernetes.io/name: mcp-gateway-migrate
    app.kubernetes.io/instance: mcp-gateway
    app.kubernetes.io/version: "0.1.0"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/component: migrate
  annotations:
    helm.sh/hook: pre-install,pre-upgrade
    helm.sh/hook-weight: "-5"
    helm.sh/hook-delete-policy: before-hook-creation
spec:
  backoffLimit: 2
  activeDeadlineSeconds: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mcp-gateway-migrate
        app.kubernetes.io/instance: mcp-gateway
        app.kubernetes.io/component: migrate
    spec:
      restartPolicy: Never
      # No serviceAccountName: the chart's ServiceAccount does not exist yet
      # during pre-install, and the Job never talks to the API.
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: "ghcr.io/huynle/mcp-gateway:0.1.0"
          imagePullPolicy: IfNotPresent
          command: ["/migrate", "up"]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
          env:
            - name: GATEWAY_MIGRATE_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "mcp-gateway-database"
                  key: "migrate-url"
          resources:
            limits:
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi

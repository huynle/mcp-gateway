# Every environment variable the gateway reads. Copy to .env (git-ignored)
# and `set -a; . ./.env; set +a` or let your shell/IDE load it.
#
# Precedence: built-in defaults < GATEWAY_CONFIG_FILE < GATEWAY_* variables.
# Values below are the defaults unless noted. Later tasks append their own
# variables here (key provider, OIDC, vendor apps, ...).

# Optional YAML file with the same keys in snake_case (listen_addr,
# drain_timeout, log_level, log_format, database_url, jobs_database_url,
# base_url, session_*, default_role, bootstrap_admins, and an
# oidc_providers list of {name, display_name, issuer, client_id,
# client_secret, allowed_domains, allowed_tenants, domain_claim}).
# Unknown keys are errors.
#GATEWAY_CONFIG_FILE=./gateway.yaml

# TCP address the HTTP server binds. Compose publishes 18080.
GATEWAY_LISTEN_ADDR=:18080

# How long shutdown waits for in-flight requests after SIGTERM before cutting
# them off. Must be shorter than the orchestrator's termination grace period
# (Compose stop_grace_period, Kubernetes terminationGracePeriodSeconds).
GATEWAY_DRAIN_TIMEOUT=25s

# debug | info | warn | error
GATEWAY_LOG_LEVEL=info

# json | text
GATEWAY_LOG_FORMAT=json

# --- database ----------------------------------------------------------------
# Three PostgreSQL roles, three connection strings (see internal/store and
# deploy/postgres/init/01-roles.sql). Unset GATEWAY_DATABASE_URL to run the
# gateway without a database (health endpoints only). When it is set,
# GATEWAY_JOBS_DATABASE_URL is required and must use a different role.
#
# Request path: role gateway_app (NOBYPASSRLS). Every user-scoped table is
# forced into row-level security on the per-transaction app.user_id setting.
GATEWAY_DATABASE_URL=postgres://gateway_app:gateway-app-dev@localhost:15432/gateway?sslmode=disable

# Background jobs and admin metadata reads: role gateway_jobs (BYPASSRLS).
GATEWAY_JOBS_DATABASE_URL=postgres://gateway_jobs:gateway-jobs-dev@localhost:15432/gateway?sslmode=disable

# Migrations (`make migrate`, cmd/migrate, the Compose "migrate" service):
# the owner/superuser. Falls back to GATEWAY_DATABASE_URL when unset, which
# only works if that role may create roles and grant BYPASSRLS, i.e. never
# with gateway_app. The gateway binary ignores this variable.
GATEWAY_MIGRATE_DATABASE_URL=postgres://gateway:gateway-dev@localhost:15432/gateway?sslmode=disable

# --- test-only ---------------------------------------------------------------
# Read by `make test-integration` (and CI). Integration tests are skipped when
# unset. Must be a superuser: the tests migrate the database up and down and
# give the gateway_app / gateway_jobs roles a temporary LOGIN password. Points
# at the Compose PostgreSQL by default.
#GATEWAY_TEST_DATABASE_URL=postgres://gateway:gateway-dev@localhost:15432/gateway?sslmode=disable

# --- Company sign-in, sessions, portal ------------------------------------
# Public origin users reach the gateway at; OIDC redirect URIs are
# <base>/auth/<provider>/callback. No trailing slash.
GATEWAY_BASE_URL=http://localhost:18080

# Browser sessions: signed out after this long without a request, and this
# long after sign-in regardless (idle must not exceed absolute).
GATEWAY_SESSION_IDLE_TIMEOUT=12h
GATEWAY_SESSION_ABSOLUTE_TIMEOUT=168h

# Secure flag on the session and sign-in cookies. Keep true everywhere
# except plain-http localhost development (Compose sets false).
GATEWAY_SESSION_COOKIE_SECURE=false

# Harness tokens (mgw_...) stop working when the owner's last company
# sign-in is older than this. Tokens themselves live at most 90 days.
GATEWAY_TOKEN_SIGNIN_MAX_AGE=720h

# Audit events older than this are deleted by the daily audit.purge job
# (one replica, batches of 10k rows). Default 8760h (365 days); at least
# 720h (30 days), there is no "keep forever".
GATEWAY_AUDIT_RETENTION=8760h

# Largest /mcp request body in bytes (one JSON-RPC message); larger
# requests get 413. 1 MiB covers any tool call.
GATEWAY_MCP_MAX_BODY=1048576

# tools/call budgets (token buckets, burst = the per-minute rate). Per user
# across every app, and per vendor app across every user: vendor quotas
# are per registered app. A refusal is a JSON-RPC error (-32029) with
# error.data.retry_after in seconds; a vendor 429 pauses that app for its
# Retry-After and is reported the same way.
GATEWAY_RATE_USER_PER_MIN=60
GATEWAY_RATE_APP_PER_MIN=600

# Per-user resource caps (fallback defaults; /admin/settings/resource-caps
# and per-user overrides on /admin/users/<id>/limits take precedence). Must
# be positive here: unlimited (0) is only an administrator setting.
GATEWAY_CAP_SERVERS=10
GATEWAY_CAP_TUNNELS=5
GATEWAY_CAP_CONNECTIONS_PER_APP=5
GATEWAY_CAP_CONNECTIONS_TOTAL=20
GATEWAY_CAP_PENDING_APPROVALS=50
GATEWAY_CAP_MACHINES=5

# How long a compiled policy (roles, user restrictions, role assignments) is
# used before the tables are read again. Role edits in the portal apply at
# once on the replica that made them; this bounds how long other replicas
# and role assignments made on /admin/users take to catch up.
GATEWAY_POLICY_RELOAD_INTERVAL=15s

# Register the in-process "fake" connector (tools fake.list_accounts,
# list_items, get_item, create_item, post_note, flaky_write) with one
# make-believe company account per user. Development and test stacks only;
# Compose sets it true. Default false.
GATEWAY_ENABLE_FAKE_CONNECTOR=false

# Ephemeral secrets (docs/secrets.md): agents ask the user for a password
# with secrets.request, the user enters it at <base>/s/<id>, and the agent
# uses it through a handle without reading it. Needs a key provider and
# user-added MCP servers; otherwise it stays off with a startup warning.
# Default false.
GATEWAY_SECRETS_ENABLED=false

# Credential links (docs/plans/2026-10-23-credential-links-and-elicitation-
# relay-design.md, plan 1): a missing or rejected credential the caller can
# fix becomes a -32042 URL elicitation linking to the server's connection
# page (the owner also gets the settings page for a shared credential).
# Missing per-user header values are refused before the call. Default false.
GATEWAY_CREDENTIAL_LINKS_ENABLED=false

# Upstream URL elicitation relay (same design, plan 2): per-user MCP servers
# may send the user to their own page; the agent gets a <base>/elicit/<id>
# link to a confirmation page showing the full upstream URL. Default false.
GATEWAY_UPSTREAM_ELICITATION_ENABLED=false

# Web Push approval notifications (docs/push-notifications.md): users turn
# notifications on per device on My account; a pending approval shows
# "Approval needed: <tool> (<account label>)" (never arguments). Needs a key
# provider and a VAPID subject: an https GATEWAY_BASE_URL, or
# GATEWAY_LEGAL_CONTACT_EMAIL (used as mailto:) for local http setups;
# otherwise it stays off with a startup warning. Egress: HTTPS to the push
# services (fcm.googleapis.com, *.push.apple.com, ...). Default false.
GATEWAY_WEBPUSH_ENABLED=false

# Role given to users created on first sign-in when no role is flagged as
# default on /admin/settings/default-role; the row is created if missing.
# Roles grant nothing until an admin edits them on /admin/roles. Admins can
# assign other roles in the portal.
GATEWAY_DEFAULT_ROLE=member

# Public sign-up (docs/public-signup.md). ALLOWED_DOMAINS="*" on a provider
# admits any account with a verified email. GATEWAY_SIGNUP_MODE decides what
# a first sign-in creates: open (active with the default role), approval
# (pending until an admin approves it on /admin/users) or invite (needs a
# single-use invite link from /admin/users). Default: approval when a
# provider uses "*", open otherwise. Existing users and bootstrap admins are
# never affected.
#GATEWAY_SIGNUP_MODE=open
# New accounts per client IP and in total per rolling hour (429 beyond).
#GATEWAY_SIGNUP_RATE_IP_PER_HOUR=10
#GATEWAY_SIGNUP_RATE_GLOBAL_PER_HOUR=100

# "issuer|subject" pairs (comma-separated) that receive the "admin" role on
# every sign-in. The subject is the provider's permanent "sub" claim, never
# the email; the gateway logs it on each sign-in (event identity.signin).
# The value below is dev@example.com at the Compose dex.
GATEWAY_BOOTSTRAP_ADMINS=http://localhost:15556/dex|CiQwOGE4Njg0Yi1kYjg4LTRiNzMtOTBhOS0zY2QxNjYxZjU0NjYSBWxvY2Fs

# Identity providers: a comma-separated list of names (lower-case letters,
# digits, hyphens), each configured by GATEWAY_OIDC_<NAME>_* with the name
# upper-cased. Every provider needs ISSUER, CLIENT_ID, CLIENT_SECRET and at
# least one of ALLOWED_DOMAINS / ALLOWED_TENANTS (ALLOWED_DOMAINS="*" alone:
# any account with a verified email, see public sign-up above). Optional: DISPLAY_NAME
# (sign-in button label) and DOMAIN_CLAIM (which claim holds the user's
# domain; default: "hd", then the verified email's domain; "email" trusts
# the email domain without the verified flag). Setting GATEWAY_OIDC_PROVIDERS
# replaces any oidc_providers list from GATEWAY_CONFIG_FILE.
GATEWAY_OIDC_PROVIDERS=dex

# Local dex (Compose). Users dev@example.com / alice@example.com, password
# "password"; mallory@evil.test is rejected by the domain allow-list.
GATEWAY_OIDC_DEX_DISPLAY_NAME=Local dex
GATEWAY_OIDC_DEX_ISSUER=http://localhost:15556/dex
GATEWAY_OIDC_DEX_CLIENT_ID=gateway
GATEWAY_OIDC_DEX_CLIENT_SECRET=gateway-dev-secret
GATEWAY_OIDC_DEX_ALLOWED_DOMAINS=example.com

# Google Workspace: an OAuth client (Web application) in Google Cloud with
# redirect URI <base>/auth/google/callback. The hosted domain ("hd" claim)
# is checked against ALLOWED_DOMAINS.
#GATEWAY_OIDC_GOOGLE_DISPLAY_NAME=Google
#GATEWAY_OIDC_GOOGLE_ISSUER=https://accounts.google.com
#GATEWAY_OIDC_GOOGLE_CLIENT_ID=
#GATEWAY_OIDC_GOOGLE_CLIENT_SECRET=
#GATEWAY_OIDC_GOOGLE_ALLOWED_DOMAINS=example.com

# Microsoft Entra ID: an app registration (Web platform) with redirect URI
# <base>/auth/entra/callback; use the tenant-specific v2.0 issuer and list
# the tenant ID(s) ("tid" claim) in ALLOWED_TENANTS.
#GATEWAY_OIDC_ENTRA_DISPLAY_NAME=Microsoft
#GATEWAY_OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#GATEWAY_OIDC_ENTRA_CLIENT_ID=
#GATEWAY_OIDC_ENTRA_CLIENT_SECRET=
#GATEWAY_OIDC_ENTRA_ALLOWED_TENANTS=<tenant-id>

# Okta: an OIDC Web application with sign-in redirect URI
# <base>/auth/okta/callback. Okta issues verified emails, so the email
# domain is checked against ALLOWED_DOMAINS.
#GATEWAY_OIDC_OKTA_DISPLAY_NAME=Okta
#GATEWAY_OIDC_OKTA_ISSUER=https://<org>.okta.com
#GATEWAY_OIDC_OKTA_CLIENT_ID=
#GATEWAY_OIDC_OKTA_CLIENT_SECRET=
#GATEWAY_OIDC_OKTA_ALLOWED_DOMAINS=example.com

# --- Approvals (decision s0p05diu) -----------------------------------------
# A tool call the policy marks "confirm" creates an approval the user decides
# on at /approvals. The stored arguments are envelope-encrypted (a key
# provider is required; without one confirmed calls are refused) and deleted
# once the approval is used, denied or expired.
# How long an approval can be decided on and, once approved, used.
#GATEWAY_APPROVAL_TTL=15m
# How long a confirmed call waits for the user before answering "approval
# required" (the harness then retries with approval_id). Keep it below the
# harness's own timeout; 0 never waits; at most 5m and shorter than the TTL.
#GATEWAY_APPROVAL_WAIT=30s

# --- Write ledger (decision dovthftx) ----------------------------------------
# Every write is recorded as in_progress before the app call. An unconfirmed
# write with the same user, account, tool and arguments inside this window
# replays the first result instead of running again (an approval-scoped
# write runs at most once regardless).
#GATEWAY_LEDGER_IDEMPOTENCY_WINDOW=24h
# An in_progress row older than this belongs to a replica that died or was
# cut off: the sweep marks it unknown and the reconciler takes over.
#GATEWAY_LEDGER_STALE_AFTER=2m
# The reconciler checks an unknown write up to this many times (attempt n
# waits 2^(n-1) minutes) and for at most this long before marking it
# unresolved, notifying the user and lifting the duplicate block.
#GATEWAY_LEDGER_MAX_RECONCILE_ATTEMPTS=6
#GATEWAY_LEDGER_MAX_RECONCILE_AGE=24h

# --- MCP OAuth authorization server (see docs/harness-setup.md) -----------
# The gateway is the OAuth 2.1 authorization server harnesses sign in with
# (decisions 3ycafouv, ysorv868): issuer = GATEWAY_BASE_URL, protected
# resource = GATEWAY_BASE_URL/mcp. It needs the key provider below (signing
# keys are stored envelope-encrypted); without one only generated tokens
# work. Refresh tokens also obey GATEWAY_TOKEN_SIGNIN_MAX_AGE.
# Access tokens are JWTs (ES256) valid for this long.
#GATEWAY_OAUTH_ACCESS_TOKEN_TTL=1h
# Refresh tokens are rotated on every use; each one lives this long.
#GATEWAY_OAUTH_REFRESH_TOKEN_TTL=720h
# Authorization codes and device codes are single use and expire after this.
#GATEWAY_OAUTH_CODE_TTL=10m
# Dynamic client registration: per-address budget, cap on registrations
# that never completed a sign-in, and how long an unused client is kept.
#GATEWAY_OAUTH_REGISTER_PER_MIN=10
#GATEWAY_OAUTH_MAX_UNUSED_CLIENTS=1000
#GATEWAY_OAUTH_CLIENT_IDLE=720h
# Device authorization grant (RFC 8628, harnesses on remote hosts):
# per-address budget for POST /oauth/device_authorization. Device codes
# expire after GATEWAY_OAUTH_CODE_TTL.
#GATEWAY_OAUTH_DEVICE_PER_MIN=10
# The signing key is replaced once it is this old; the previous key keeps
# verifying tokens for the grace period, then is deleted.
#GATEWAY_OAUTH_KEY_ROTATION=720h
#GATEWAY_OAUTH_KEY_GRACE=2h

# --- Envelope encryption key provider (see docs/crypto.md) ---------------
# file (default), vault, or migrate (cutover from file to Vault/OpenBao: reads
# file-key envelopes, wraps new data with Vault; needs both the key file and
# the Vault settings; docs/crypto.md "Moving from file to Vault/OpenBao").
# Unset both GATEWAY_KEY_PROVIDER and GATEWAY_KEY_FILE
# to run without a key provider (health-only mode; approvals, app
# connections and MCP OAuth sign-in, which all encrypt what they store, are
# then unavailable).
#GATEWAY_KEY_PROVIDER=file
# Dev key file (mode 0600); create one with crypto.GenerateKeyFile (see
# docs/crypto.md). Never commit it.
#GATEWAY_KEY_FILE=.dev/keys.json
# Vault / OpenBao transit settings when GATEWAY_KEY_PROVIDER=vault or migrate
#GATEWAY_VAULT_ADDR=http://localhost:18200
#GATEWAY_VAULT_TOKEN=
#GATEWAY_VAULT_TRANSIT_KEY=mcp-gateway
#GATEWAY_VAULT_MOUNT=transit

# --- Cross-replica tunnel relay (see docs/tunnel.md "Multiple replicas") ----
# Set all three (or none: single replica, current behaviour). The listener is
# internal only: never route it through the ingress.
#GATEWAY_RELAY_LISTEN_ADDR=:18081
#GATEWAY_RELAY_ADVERTISE_ADDR=http://$(POD_IP):18081
# >= 32 bytes, identical on every replica, e.g. openssl rand -hex 32
#GATEWAY_RELAY_SECRET=

# --- User-added (federated) MCP servers -----------------------------------
# How long one tools/call on a user-added MCP server may run, end to end
# (netguard, the tunnel and the cross-replica relay included). Go duration,
# > 0 and at most 15m; default 30s. Only tools/call: discovery, lists,
# initialize, resources, prompts and OAuth keep 30s. Trade-off: a slow
# upstream holds the caller's /mcp request and its connection for up to
# this long (and the gateway answers /mcp with one JSON body, so nothing is
# sent before the result). Keep GATEWAY_LEDGER_STALE_AFTER above it (the
# gateway warns at startup otherwise) and any reverse proxy's response
# timeout above it too. docs/federation-connector.md "Call timeout".
#GATEWAY_FEDERATION_CALL_TIMEOUT=30s

# --- Observability (see docs/observability.md) ----------------------------
# Private Prometheus listener; never expose publicly.
#GATEWAY_METRICS_ADDR=127.0.0.1:19090
# Salt for pseudonymous user IDs in logs. Unset = random per process.
#GATEWAY_LOG_SALT=

# --- Public pages: homepage, /privacy, /terms, /support (docs/public-launch.md)
# Shown on the public homepage and the DRAFT legal texts. Unset values render
# as visible placeholders ("[operator name]") and the gateway logs a warning
# at startup. Bad values (a non-address email, a date not YYYY-MM-DD,
# control characters, more than 200 characters) fail startup.
# Person or organisation running this gateway (the data controller).
#GATEWAY_LEGAL_OPERATOR_NAME=Example Labs LLC
# Bare address for privacy, support and security requests (mailto link).
#GATEWAY_LEGAL_CONTACT_EMAIL=privacy@example.com
# Governing law named in the terms ("the laws of <jurisdiction>").
#GATEWAY_LEGAL_JURISDICTION=the State of Washington, USA
# When the current texts took effect, YYYY-MM-DD.
#GATEWAY_LEGAL_EFFECTIVE_DATE=2026-10-18
# Shows "Draft – pending review" on /privacy and /terms. Set false only after
# the texts were reviewed by counsel.
#GATEWAY_LEGAL_DRAFT=true

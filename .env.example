# Every environment variable the gateway reads. Copy to .env (git-ignored)
# and `set -a; . ./.env; set +a` or let your shell/IDE load it.
#
# Precedence: built-in defaults < GATEWAY_CONFIG_FILE < GATEWAY_* variables.
# Values below are the defaults unless noted. Later tasks append their own
# variables here (key provider, OIDC, vendor apps, ...).

# Optional YAML file with the same keys in snake_case (listen_addr,
# drain_timeout, log_level, log_format, database_url, jobs_database_url).
# Unknown keys are errors.
#GATEWAY_CONFIG_FILE=./gateway.yaml

# TCP address the HTTP server binds. Compose publishes 18080.
GATEWAY_LISTEN_ADDR=:18080

# How long shutdown waits for in-flight requests after SIGTERM before cutting
# them off. Must be shorter than the orchestrator's termination grace period
# (Compose stop_grace_period, Kubernetes terminationGracePeriodSeconds).
GATEWAY_DRAIN_TIMEOUT=25s

# debug | info | warn | error
GATEWAY_LOG_LEVEL=info

# json | text
GATEWAY_LOG_FORMAT=json

# --- database ----------------------------------------------------------------
# Three PostgreSQL roles, three connection strings (see internal/store and
# deploy/postgres/init/01-roles.sql). Unset GATEWAY_DATABASE_URL to run the
# gateway without a database (health endpoints only). When it is set,
# GATEWAY_JOBS_DATABASE_URL is required and must use a different role.
#
# Request path: role gateway_app (NOBYPASSRLS). Every user-scoped table is
# forced into row-level security on the per-transaction app.user_id setting.
GATEWAY_DATABASE_URL=postgres://gateway_app:gateway-app-dev@localhost:15432/gateway?sslmode=disable

# Background jobs and admin metadata reads: role gateway_jobs (BYPASSRLS).
GATEWAY_JOBS_DATABASE_URL=postgres://gateway_jobs:gateway-jobs-dev@localhost:15432/gateway?sslmode=disable

# Migrations (`make migrate`, cmd/migrate, the Compose "migrate" service):
# the owner/superuser. Falls back to GATEWAY_DATABASE_URL when unset, which
# only works if that role may create roles and grant BYPASSRLS, i.e. never
# with gateway_app. The gateway binary ignores this variable.
GATEWAY_MIGRATE_DATABASE_URL=postgres://gateway:gateway-dev@localhost:15432/gateway?sslmode=disable

# --- test-only ---------------------------------------------------------------
# Read by `make test-integration` (and CI). Integration tests are skipped when
# unset. Must be a superuser: the tests migrate the database up and down and
# give the gateway_app / gateway_jobs roles a temporary LOGIN password. Points
# at the Compose PostgreSQL by default.
#GATEWAY_TEST_DATABASE_URL=postgres://gateway:gateway-dev@localhost:15432/gateway?sslmode=disable
